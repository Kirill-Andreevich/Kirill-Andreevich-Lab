    {
      "mode": "managed",
      "type": "libvirt_cloudinit_disk",
      "name": "init_gitlab",
      "provider": "provider[\"registry.terraform.io/dmacvicar/libvirt\"].workstation",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "/var/lib/libvirt/images/init-gitlab.iso;a0bd7145-0273-4e5c-9927-42dbe024e7dc",
            "meta_data": "",
            "name": "init-gitlab.iso",
            "network_config": "version: 2\nethernets:\n  id0:\n    match:\n      name: en*\n    dhcp4: false\n    addresses:\n      - 192.168.1.101/24\n    routes:\n      - to: default\n        via: 192.168.1.1\n    nameservers:\n      addresses: [192.168.1.1, 8.8.8.8]\n",
            "pool": "default",
            "user_data": "#cloud-config\nusers:\n  - name: km\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    ssh-authorized-keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFuUNjKZX6TFQF0qwQFz+NREEl779Ew5F6Q88BGbw9rr km@km\n\npackages:\n  - qemu-guest-agent\n  - open-iscsi\n  - nfs-common\nruncmd:\n  - [ systemctl, enable, --now, qemu-guest-agent ]\n  - [ systemctl, enable, --now, iscsid ]\n  - mkdir -p /run/flannel\n  - |\n    cat \u003c\u003cFLN \u003e /run/flannel/subnet.env\n    FLANNEL_NETWORK=10.244.0.0/16\n    FLANNEL_SUBNET=10.244.1.1/24\n    FLANNEL_MTU=1450\n    FLANNEL_IPMASQ=true\n    FLN\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
